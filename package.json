{
  "name": "kb-vault",
  "displayName": "KB Vault",
  "description": "GTD-powered knowledge and context management for AI coding assistants",
  "version": "0.2.0",
  "publisher": "lwbailey",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kbvault.openEditor",
        "title": "KB Vault: Open in WYSIWYG Editor",
        "shortTitle": "Open Editor",
        "icon": "$(edit)"
      },
      {
        "command": "kbvault.openVault",
        "title": "KB Vault: Open Vault Folder",
        "shortTitle": "Open Vault"
      },
      {
        "command": "kbvault.newNote",
        "title": "KB Vault: New Note",
        "shortTitle": "New Note",
        "icon": "$(add)"
      },
      {
        "command": "kbvault.newTask",
        "title": "KB Vault: New Task",
        "shortTitle": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "kbvault.compileContext",
        "title": "KB Vault: Compile Context for AI",
        "shortTitle": "Compile Context",
        "icon": "$(export)"
      },
      {
        "command": "kbvault.generateClaudeMd",
        "title": "KB Vault: Generate CLAUDE.md",
        "shortTitle": "Generate CLAUDE.md"
      },
      {
        "command": "kbvault.generateCopilotInstructions",
        "title": "KB Vault: Generate Copilot Instructions",
        "shortTitle": "Generate Copilot Instructions"
      },
      {
        "command": "kbvault.logActivity",
        "title": "KB Vault: Log Activity",
        "shortTitle": "Log Activity",
        "icon": "$(note)"
      },
      {
        "command": "kbvault.refresh",
        "title": "KB Vault: Refresh",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kbvault.setTaskStatus",
        "title": "KB Vault: Set Task Status",
        "shortTitle": "Set Status",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "kbvault.deleteNote",
        "title": "KB Vault: Delete Note",
        "shortTitle": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "kbvault.markDone",
        "title": "KB Vault: Mark Done",
        "shortTitle": "Mark Done",
        "icon": "$(check)"
      },
      {
        "command": "kbvault.initWorkspace",
        "title": "KB Vault: Initialize Workspace Vault",
        "shortTitle": "Init Workspace Vault",
        "icon": "$(folder-add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kb-vault",
          "title": "KB Vault",
          "icon": "./images/icon.svg"
        }
      ]
    },
    "views": {
      "kb-vault": [
        {
          "id": "kbvault.tasks",
          "name": "Tasks"
        },
        {
          "id": "kbvault.vault",
          "name": "Vault"
        },
        {
          "id": "kbvault.sessions",
          "name": "Recent Activity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kbvault.newTask",
          "when": "view == kbvault.tasks",
          "group": "navigation@1"
        },
        {
          "command": "kbvault.newNote",
          "when": "view == kbvault.vault",
          "group": "navigation@1"
        },
        {
          "command": "kbvault.initWorkspace",
          "when": "view == kbvault.vault",
          "group": "navigation@2"
        },
        {
          "command": "kbvault.compileContext",
          "when": "view == kbvault.tasks",
          "group": "navigation@2"
        },
        {
          "command": "kbvault.logActivity",
          "when": "view == kbvault.sessions",
          "group": "navigation@1"
        },
        {
          "command": "kbvault.refresh",
          "when": "view =~ /kbvault/",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "kbvault.setTaskStatus",
          "when": "view == kbvault.tasks && viewItem == task-item",
          "group": "1_actions@1"
        },
        {
          "command": "kbvault.markDone",
          "when": "view == kbvault.tasks && viewItem == task-item",
          "group": "1_actions@2"
        },
        {
          "command": "kbvault.deleteNote",
          "when": "viewItem == vault-file || viewItem == task-item",
          "group": "2_delete@1"
        },
        {
          "command": "kbvault.compileContext",
          "when": "viewItem == vault-file || viewItem == task-item",
          "group": "1_actions@3"
        }
      ]
    },
    "configuration": {
      "title": "KB Vault",
      "properties": {
        "kbvault.globalPath": {
          "type": "string",
          "default": "",
          "description": "Path to the global vault directory. Defaults to ~/.kbvault"
        },
        "kbvault.gtd.contexts": {
          "type": "array",
          "default": [
            "@computer",
            "@phone",
            "@office",
            "@home",
            "@errands",
            "@anywhere"
          ],
          "description": "GTD contexts for task categorization"
        },
        "kbvault.context.maxTokenEstimate": {
          "type": "number",
          "default": 4000,
          "description": "Approximate max tokens when compiling AI context"
        },
        "kbvault.autoDetectStaleness": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect stale CLAUDE.md/copilot-instructions.md on workspace open"
        },
        "kbvault.newTaskDefaultScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "workspace",
          "description": "Default scope when creating new tasks (if workspace vault exists)"
        },
        "kbvault.newNoteDefaultScope": {
          "type": "string",
          "enum": [
            "global",
            "workspace"
          ],
          "default": "global",
          "description": "Default scope when creating new notes"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2"
  }
}
