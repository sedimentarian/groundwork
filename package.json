{
  "name": "groundwork",
  "displayName": "Groundwork",
  "description": "The context layer your AI tools are missing — structured notes, reference knowledge, and task management that feeds directly into Copilot, Claude, and any AI coding assistant",
  "version": "0.6.0",
  "publisher": "sedimentarian",
  "license": "GPL-3.0-only",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sedimentarian/groundwork"
  },
  "homepage": "https://github.com/sedimentarian/groundwork#readme",
  "bugs": {
    "url": "https://github.com/sedimentarian/groundwork/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "gtd",
    "tasks",
    "knowledge-management",
    "ai-context",
    "claude",
    "copilot",
    "productivity",
    "notes",
    "vault"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "groundwork.openEditor",
        "title": "Groundwork: Open in WYSIWYG Editor",
        "shortTitle": "Open Editor",
        "icon": "$(edit)"
      },
      {
        "command": "groundwork.openVault",
        "title": "Groundwork: Open Vault Folder",
        "shortTitle": "Open Vault"
      },
      {
        "command": "groundwork.newNote",
        "title": "Groundwork: New Note",
        "shortTitle": "New Note",
        "icon": "$(add)"
      },
      {
        "command": "groundwork.newTask",
        "title": "Groundwork: New Task",
        "shortTitle": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "groundwork.compileContext",
        "title": "Groundwork: Compile Context for AI",
        "shortTitle": "Compile Context",
        "icon": "$(export)"
      },
      {
        "command": "groundwork.generateClaudeMd",
        "title": "Groundwork: Generate CLAUDE.md",
        "shortTitle": "Generate CLAUDE.md"
      },
      {
        "command": "groundwork.generateCopilotInstructions",
        "title": "Groundwork: Generate Copilot Instructions",
        "shortTitle": "Generate Copilot Instructions"
      },
      {
        "command": "groundwork.logActivity",
        "title": "Groundwork: Log Activity",
        "shortTitle": "Log Activity",
        "icon": "$(note)"
      },
      {
        "command": "groundwork.refresh",
        "title": "Groundwork: Refresh",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "groundwork.setTaskStatus",
        "title": "Groundwork: Set Task Status",
        "shortTitle": "Set Status",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "groundwork.deleteNote",
        "title": "Groundwork: Delete Note",
        "shortTitle": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "groundwork.markDone",
        "title": "Groundwork: Mark Done",
        "shortTitle": "Mark Done",
        "icon": "$(check)"
      },
      {
        "command": "groundwork.initWorkspace",
        "title": "Groundwork: Initialize Workspace Vault",
        "shortTitle": "Init Workspace Vault",
        "icon": "$(folder-add)"
      },
      {
        "command": "groundwork.moveToGlobal",
        "title": "Groundwork: Move to Global Vault",
        "shortTitle": "Move to Global",
        "icon": "$(globe)"
      },
      {
        "command": "groundwork.moveToWorkspace",
        "title": "Groundwork: Move to Workspace Vault",
        "shortTitle": "Move to Workspace",
        "icon": "$(folder)"
      },
      {
        "command": "groundwork.compileActiveContext",
        "title": "Groundwork: Copy Active Context to Clipboard",
        "shortTitle": "Quick Context",
        "icon": "$(zap)"
      },
      {
        "command": "groundwork.newNoteHere",
        "title": "Groundwork: New Note Here",
        "shortTitle": "New Note Here",
        "icon": "$(add)"
      },
      {
        "command": "groundwork.dailyBriefing",
        "title": "Groundwork: Daily Briefing",
        "shortTitle": "Daily Briefing",
        "icon": "$(calendar)"
      },
      {
        "command": "groundwork.weeklyReview",
        "title": "Groundwork: Weekly Review",
        "shortTitle": "Weekly Review",
        "icon": "$(history)"
      },
      {
        "command": "groundwork.filterByTag",
        "title": "Groundwork: Filter Tasks",
        "shortTitle": "Filter",
        "icon": "$(filter)"
      },
      {
        "command": "groundwork.searchTasks",
        "title": "Groundwork: Search Tasks",
        "shortTitle": "Search",
        "icon": "$(search)"
      },
      {
        "command": "groundwork.clearTagFilter",
        "title": "Groundwork: Clear Filters",
        "shortTitle": "Clear Filters",
        "icon": "$(close)"
      },
      {
        "command": "groundwork.searchVault",
        "title": "Groundwork: Search Vault",
        "shortTitle": "Search Vault",
        "icon": "$(search)"
      },
      {
        "command": "groundwork.clearVaultFilter",
        "title": "Groundwork: Clear Vault Filters",
        "shortTitle": "Clear Filters",
        "icon": "$(close)"
      },
      {
        "command": "groundwork.filterVault",
        "title": "Groundwork: Filter Vault",
        "shortTitle": "Filter",
        "icon": "$(filter)"
      },
      {
        "command": "groundwork.collapseAllTasks",
        "title": "Groundwork: Collapse All Tasks",
        "shortTitle": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "groundwork.expandAllTasks",
        "title": "Groundwork: Expand All Tasks",
        "shortTitle": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "groundwork.collapseAllVault",
        "title": "Groundwork: Collapse All Vault",
        "shortTitle": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "groundwork.expandAllVault",
        "title": "Groundwork: Expand All Vault",
        "shortTitle": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "groundwork.renameNote",
        "title": "Groundwork: Rename",
        "shortTitle": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "groundwork.archiveNote",
        "title": "Groundwork: Archive",
        "shortTitle": "Archive",
        "icon": "$(archive)"
      },
      {
        "command": "groundwork.unarchiveNote",
        "title": "Groundwork: Unarchive",
        "shortTitle": "Unarchive",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groundwork",
          "title": "Groundwork",
          "icon": "./images/icon.svg"
        }
      ]
    },
    "views": {
      "groundwork": [
        {
          "id": "groundwork.tasks",
          "name": "Tasks"
        },
        {
          "id": "groundwork.vault",
          "name": "Vault"
        },
        {
          "id": "groundwork.sessions",
          "name": "Recent Activity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "groundwork.dailyBriefing",
          "when": "view == groundwork.tasks",
          "group": "navigation@0"
        },
        {
          "command": "groundwork.weeklyReview",
          "when": "view == groundwork.tasks",
          "group": "navigation@1"
        },
        {
          "command": "groundwork.newTask",
          "when": "view == groundwork.tasks",
          "group": "navigation@2"
        },
        {
          "command": "groundwork.filterByTag",
          "when": "view == groundwork.tasks",
          "group": "navigation@3"
        },
        {
          "command": "groundwork.searchTasks",
          "when": "view == groundwork.tasks",
          "group": "navigation@4"
        },
        {
          "command": "groundwork.clearTagFilter",
          "when": "view == groundwork.tasks && groundwork.tagFilterActive",
          "group": "navigation@5"
        },
        {
          "command": "groundwork.collapseAllTasks",
          "when": "view == groundwork.tasks && !groundwork.tasksCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "groundwork.expandAllTasks",
          "when": "view == groundwork.tasks && groundwork.tasksCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "groundwork.newNote",
          "when": "view == groundwork.vault",
          "group": "navigation@2"
        },
        {
          "command": "groundwork.filterVault",
          "when": "view == groundwork.vault",
          "group": "navigation@3"
        },
        {
          "command": "groundwork.searchVault",
          "when": "view == groundwork.vault",
          "group": "navigation@4"
        },
        {
          "command": "groundwork.clearVaultFilter",
          "when": "view == groundwork.vault && groundwork.vaultFilterActive",
          "group": "navigation@5"
        },
        {
          "command": "groundwork.collapseAllVault",
          "when": "view == groundwork.vault && !groundwork.vaultCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "groundwork.expandAllVault",
          "when": "view == groundwork.vault && groundwork.vaultCollapsed",
          "group": "navigation@6"
        },
        {
          "command": "groundwork.initWorkspace",
          "when": "view == groundwork.vault && !groundwork.hasWorkspaceVault",
          "group": "navigation@7"
        },
        {
          "command": "groundwork.logActivity",
          "when": "view == groundwork.sessions",
          "group": "navigation@1"
        },
        {
          "command": "groundwork.refresh",
          "when": "view =~ /groundwork/",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "groundwork.setTaskStatus",
          "when": "view == groundwork.tasks && viewItem =~ /^task-item/",
          "group": "1_actions@1"
        },
        {
          "command": "groundwork.markDone",
          "when": "view == groundwork.tasks && viewItem =~ /^task-item/",
          "group": "1_actions@2"
        },
        {
          "command": "groundwork.compileContext",
          "when": "viewItem =~ /^vault-file-(global|workspace)$/ || viewItem =~ /^task-item/",
          "group": "1_actions@3"
        },
        {
          "command": "groundwork.compileActiveContext",
          "when": "viewItem =~ /^task-item/",
          "group": "1_actions@4"
        },
        {
          "command": "groundwork.moveToWorkspace",
          "when": "viewItem =~ /^task-item-global/ || viewItem == vault-file-global",
          "group": "2_move@1"
        },
        {
          "command": "groundwork.moveToGlobal",
          "when": "viewItem =~ /^task-item-workspace/ || viewItem == vault-file-workspace",
          "group": "2_move@1"
        },
        {
          "command": "groundwork.renameNote",
          "when": "viewItem =~ /^vault-file/ || viewItem =~ /^task-item/",
          "group": "2_move@2"
        },
        {
          "command": "groundwork.archiveNote",
          "when": "viewItem =~ /^vault-file-(global|workspace)$/",
          "group": "3_delete@1"
        },
        {
          "command": "groundwork.unarchiveNote",
          "when": "viewItem =~ /^vault-file-archived/",
          "group": "3_delete@1"
        },
        {
          "command": "groundwork.deleteNote",
          "when": "viewItem =~ /^vault-file-archived/ || viewItem =~ /^task-item-.+-(done|cancelled)$/",
          "group": "3_delete@2"
        },
        {
          "command": "groundwork.newNoteHere",
          "when": "viewItem == vault-folder",
          "group": "1_actions@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "groundwork.newTask",
        "key": "cmd+shift+g cmd+shift+t",
        "linux": "ctrl+shift+g ctrl+shift+t"
      },
      {
        "command": "groundwork.newNote",
        "key": "cmd+shift+g cmd+shift+n",
        "linux": "ctrl+shift+g ctrl+shift+n"
      },
      {
        "command": "groundwork.dailyBriefing",
        "key": "cmd+shift+g cmd+shift+b",
        "linux": "ctrl+shift+g ctrl+shift+b"
      },
      {
        "command": "groundwork.compileActiveContext",
        "key": "cmd+shift+g cmd+shift+c",
        "linux": "ctrl+shift+g ctrl+shift+c"
      },
      {
        "command": "groundwork.searchTasks",
        "key": "cmd+shift+g cmd+shift+s",
        "linux": "ctrl+shift+g ctrl+shift+s"
      },
      {
        "command": "groundwork.logActivity",
        "key": "cmd+shift+g cmd+shift+l",
        "linux": "ctrl+shift+g ctrl+shift+l"
      },
      {
        "command": "groundwork.renameNote",
        "key": "f2",
        "when": "focusedView == groundwork.tasks || focusedView == groundwork.vault"
      }
    ],
    "configuration": {
      "title": "Groundwork",
      "properties": {
        "groundwork.globalPath": {
          "type": "string",
          "default": "",
          "description": "Path to the global vault directory. Defaults to ~/.groundwork"
        },
        "groundwork.gtd.contexts": {
          "type": "array",
          "default": [
            "@computer",
            "@phone",
            "@office",
            "@home",
            "@errands",
            "@anywhere"
          ],
          "description": "GTD contexts for task categorization"
        },
        "groundwork.context.maxTokenEstimate": {
          "type": "number",
          "default": 4000,
          "description": "Approximate max tokens when compiling AI context"
        },
        "groundwork.autoDetectStaleness": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect stale CLAUDE.md/copilot-instructions.md on workspace open"
        },
        "groundwork.newTaskDefaultScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "workspace",
          "description": "Default scope when creating new tasks (if workspace vault exists)"
        },
        "groundwork.newNoteDefaultScope": {
          "type": "string",
          "enum": [
            "global",
            "workspace"
          ],
          "default": "global",
          "description": "Default scope when creating new notes"
        },
        "groundwork.dailyBriefing.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the Daily Briefing once per day when VSCode starts"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "groundwork",
        "label": "Groundwork Vault"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.89.0",
    "marked": "^17.0.4",
    "turndown": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
